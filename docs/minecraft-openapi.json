{
  "openapi": "3.1.0",
  "info": {
    "title": "API REST - Minecraft",
    "description": "Gestion de entidades, simulacion de explosiones y consulta de objetos externos. Incluye POST /api/explosiones/validar, de solo lectura, para ser consumido por Amir como A2.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://100.79.75.27:8081",
      "description": "Sofía - red del trío"
    },
    {
      "url": "http://localhost:8081",
      "description": "Sofía - local"
    }
  ],
  "tags": [
    {
      "name": "Entidades",
      "description": "CRUD de entidades persistidas en H2"
    },
    {
      "name": "Explosiones",
      "description": "Simulacion transaccional de explosiones de creepers"
    },
    {
      "name": "Comportamientos",
      "description": "Ejemplos de comportamiento de las entidades"
    },
    {
      "name": "Demoliciones coordinadas",
      "description": "Sofi coordina la disponibilidad de Nico y la explosion de Amir"
    },
    {
      "name": "Combates integrados",
      "description": "Reglas de ataque locales combinadas con el Minecraft remoto"
    },
    {
      "name": "Inicio",
      "description": "Presentacion de la API"
    },
    {
      "name": "Zombies",
      "description": "Construccion de un zombie de ejemplo sin persistirlo"
    },
    {
      "name": "Objetos externos",
      "description": "Consulta de restful-api.dev mediante WebClient"
    },
    {
      "name": "Sonidos",
      "description": "Ejemplos de sonidos de las entidades"
    }
  ],
  "paths": {
    "/api/entidades/{id}": {
      "get": {
        "tags": [
          "Entidades"
        ],
        "summary": "Obtener una entidad por su ID",
        "operationId": "obtener",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la entidad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entidad encontrada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntidadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/EntidadNoEncontrada"
          }
        }
      },
      "put": {
        "tags": [
          "Entidades"
        ],
        "summary": "Actualizar una entidad",
        "description": "Reemplaza nombre, salud y ubicacion; actualiza los atributos informados. El tipo no puede cambiar.",
        "operationId": "actualizar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la entidad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntidadRequest"
              },
              "example": {
                "nombre": "Zombie1",
                "tipo": "ZOMBIE",
                "salud": 20,
                "ubicacion": {
                  "x": 0,
                  "y": 64,
                  "z": 0
                },
                "atributos": {
                  "velocidad": 1.5
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Entidad actualizada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntidadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/EntidadNoEncontrada"
          }
        }
      },
      "delete": {
        "tags": [
          "Entidades"
        ],
        "summary": "Eliminar una entidad",
        "operationId": "eliminar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la entidad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Entidad eliminada; sin cuerpo de respuesta"
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/EntidadNoEncontrada"
          }
        }
      }
    },
    "/api/explosiones": {
      "post": {
        "tags": [
          "Explosiones"
        ],
        "summary": "Simular una explosion",
        "description": "Recibe los IDs distintos de un creeper vivo, un jugador y un cerdo. Aplica hasta 20 puntos de danio dentro de un radio de 6 bloques y consume la salud del creeper.",
        "operationId": "simular",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplosionRequest"
              },
              "example": {
                "creeperId": "11111111-1111-4111-8111-111111111111",
                "jugadorId": "22222222-2222-4222-8222-222222222222",
                "cerdoId": "33333333-3333-4333-8333-333333333333"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Explosion realizada y cambios guardados",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExplosionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/EntidadNoEncontrada"
          },
          "409": {
            "$ref": "#/components/responses/EstadoInvalido"
          }
        }
      }
    },
    "/api/explosiones/validar": {
      "post": {
        "tags": [
          "Explosiones"
        ],
        "summary": "Validar una explosion sin efectos secundarios",
        "description": "Solo lectura: no modifica H2, no aplica dano, no consume ni mata al Creeper, no elimina entidades ni guarda historial. Reutiliza las mismas validaciones que POST /api/explosiones: tres UUID distintos, participantes existentes de tipo Creeper, Jugador y Cerdo y Creeper vivo. No requiere que el jugador y el cerdo esten vivos ni que esten dentro del radio. No llama a Amir ni a Nicolas. Repetir la consulta conserva la base de datos. La aprobacion describe el estado consultado y no reserva una ejecucion futura.",
        "operationId": "validar",
        "requestBody": {
          "description": "El mismo cuerpo que recibe POST /api/explosiones",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplosionRequest"
              },
              "examples": {
                "200": {
                  "summary": "Aceptado",
                  "value": {
                    "creeperId": "3257d1ac-73b6-421e-801a-0dbffd67ba18",
                    "jugadorId": "4cf40b15-4f36-4a94-be20-adfe6ecac178",
                    "cerdoId": "5e889821-046a-466a-97fb-a9fadb124a8a"
                  }
                },
                "409": {
                  "summary": "Rechazado: Creeper muerto",
                  "value": {
                    "creeperId": "225c8ba6-279b-4f7c-8531-0cda58db456d",
                    "jugadorId": "4cf40b15-4f36-4a94-be20-adfe6ecac178",
                    "cerdoId": "5e889821-046a-466a-97fb-a9fadb124a8a"
                  }
                },
                "400": {
                  "summary": "Rechazado: IDs repetidos",
                  "value": {
                    "creeperId": "3257d1ac-73b6-421e-801a-0dbffd67ba18",
                    "jugadorId": "4cf40b15-4f36-4a94-be20-adfe6ecac178",
                    "cerdoId": "4cf40b15-4f36-4a94-be20-adfe6ecac178"
                  }
                },
                "404": {
                  "summary": "Rechazado: participante inexistente",
                  "value": {
                    "creeperId": "7eb4d73c-394d-4270-9d33-ee69a84e0c9e",
                    "jugadorId": "4cf40b15-4f36-4a94-be20-adfe6ecac178",
                    "cerdoId": "5e889821-046a-466a-97fb-a9fadb124a8a"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Explosion aceptada; H2 permanece sin cambios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidacionExplosionResponse"
                },
                "example": {
                  "aceptada": true,
                  "creeperId": "3257d1ac-73b6-421e-801a-0dbffd67ba18",
                  "jugadorId": "4cf40b15-4f36-4a94-be20-adfe6ecac178",
                  "cerdoId": "5e889821-046a-466a-97fb-a9fadb124a8a"
                }
              }
            }
          },
          "400": {
            "description": "JSON o UUID invalidos, campos ausentes, IDs repetidos o tipos incorrectos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Las tres entidades deben tener identificadores distintos"
                }
              }
            }
          },
          "404": {
            "description": "Alguna entidad no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "No existe una entidad con id 7eb4d73c-394d-4270-9d33-ee69a84e0c9e"
                }
              }
            }
          },
          "409": {
            "description": "El estado del Creeper impide explotar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Un creeper muerto no puede explotar"
                }
              }
            }
          }
        }
      }
    },
    "/api/entidades": {
      "get": {
        "tags": [
          "Entidades"
        ],
        "summary": "Listar entidades",
        "description": "Devuelve todas las entidades guardadas y sus atributos.",
        "operationId": "listar",
        "responses": {
          "200": {
            "description": "Lista de entidades; puede estar vacia",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntidadResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Entidades"
        ],
        "summary": "Crear una entidad",
        "description": "Valida los datos y atributos segun el tipo y guarda la entidad.",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntidadRequest"
              },
              "example": {
                "nombre": "Zombie1",
                "tipo": "ZOMBIE",
                "salud": 20,
                "ubicacion": {
                  "x": 0,
                  "y": 64,
                  "z": 0
                },
                "atributos": {
                  "velocidad": 1.5
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Entidad creada",
            "headers": {
              "Location": {
                "description": "URL de la nueva entidad",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EntidadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          }
        }
      }
    },
    "/api/demoliciones": {
      "get": {
        "tags": [
          "Demoliciones coordinadas"
        ],
        "summary": "Listar demoliciones confirmadas y guardadas por Sofi",
        "operationId": "listar_1",
        "responses": {
          "200": {
            "description": "Historial local; no consulta las APIs de Nico ni de Amir",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DemolicionResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Demoliciones coordinadas"
        ],
        "summary": "Ejecutar una demolicion coordinada con Nico y Amir",
        "description": "Consulta GET /api/minecraft/explosivos/{id} de Nico. Solo con puedeExplotar=true envia POST /api/lp3/explosiones/simular a Amir con creeperId. Amir aplica dano real y elimina su Creeper. Sofi guarda en H2 solo las explosiones confirmadas. Los dos IDs identifican entidades independientes. No hay reintentos automaticos ni rollback remoto.",
        "operationId": "ejecutar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemolicionRequest"
              },
              "example": {
                "explosivoNicoId": "b26bb20b-a15f-43ed-b4a9-f2c19480516e",
                "creeperAmirId": 25
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Explosion confirmada por Amir y registrada por Sofi",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DemolicionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud invalida o rechazada por Amir"
          },
          "404": {
            "description": "Explosivo de Nico o Creeper de Amir inexistente"
          },
          "409": {
            "description": "Nico no autoriza el explosivo o Amir rechaza la explosion"
          },
          "502": {
            "description": "Fallo HTTP, de conexion o de contrato remoto; verificar Amir antes de repetir"
          },
          "504": {
            "description": "Tiempo de espera agotado; el resultado en Amir puede ser incierto"
          },
          "503": {
            "description": "Amir confirmo la explosion pero fallo el registro en H2"
          }
        }
      }
    },
    "/api/combates/integrados": {
      "post": {
        "tags": [
          "Combates integrados"
        ],
        "summary": "Simular un combate entre proyectos",
        "description": "Calcula el danio del atacante local y lo envia con WebClient a GET /entidad/{tipo}?danio=... del proyecto remoto. El otro proyecto construye una entidad temporal, ejecuta su comportamiento y evalua vida, muerte y drops. CREEPER puede explotar durante ese comportamiento. No modifica entidades persistidas de ninguno de los dos proyectos.",
        "operationId": "simular_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CombateIntegradoRequest"
              },
              "example": {
                "atacanteId": "11111111-1111-1111-1111-111111111111",
                "tipoObjetivo": "ZOMBIE",
                "golpes": 5
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ataque local y resultado de las reglas remotas",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CombateIntegradoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/EntidadNoEncontrada"
          },
          "409": {
            "$ref": "#/components/responses/EstadoInvalido"
          },
          "502": {
            "description": "Error HTTP, de conexion o de respuesta del servidor remoto"
          },
          "504": {
            "description": "El servidor remoto supero el tiempo limite"
          }
        }
      }
    },
    "/api/zombie": {
      "get": {
        "tags": [
          "Zombies"
        ],
        "summary": "Construir un zombie con parametros de URL",
        "description": "El nombre no puede estar vacio; las coordenadas deben ser finitas y la velocidad no negativa.",
        "operationId": "crearZombie",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "description": "Nombre del zombie",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Zombie1"
          },
          {
            "name": "x",
            "in": "query",
            "description": "Coordenada X",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 0
          },
          {
            "name": "y",
            "in": "query",
            "description": "Coordenada Y",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 64
          },
          {
            "name": "z",
            "in": "query",
            "description": "Coordenada Z",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 0
          },
          {
            "name": "velocidad",
            "in": "query",
            "description": "Velocidad finita y no negativa",
            "required": true,
            "schema": {
              "type": "string",
              "minimum": 0
            },
            "example": 1.5
          }
        ],
        "responses": {
          "200": {
            "description": "Zombie construido; no se guarda en H2",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ZombieResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametros ausentes, de tipo incorrecto o rechazados por el dominio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": "La velocidad debe ser finita y no negativa"
                }
              }
            }
          }
        }
      }
    },
    "/api/sonidos": {
      "get": {
        "tags": [
          "Sonidos"
        ],
        "summary": "Obtener los sonidos de un zombie y un cerdo",
        "operationId": "obtenerSonidos",
        "responses": {
          "200": {
            "description": "Sonidos de las dos entidades de ejemplo",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SonidosResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/objetos": {
      "get": {
        "tags": [
          "Objetos externos"
        ],
        "summary": "Listar objetos de la API externa",
        "description": "Consulta /objects sin persistir los resultados. El campo data tiene propiedades variables y puede ser nulo.",
        "operationId": "listar_2",
        "responses": {
          "200": {
            "description": "Lista de objetos externos",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ObjetoResponse"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Fallo de conexion o error HTTP de la API externa"
          },
          "504": {
            "description": "La API externa supero el tiempo limite configurado"
          }
        }
      }
    },
    "/api/demoliciones/{id}": {
      "get": {
        "tags": [
          "Demoliciones coordinadas"
        ],
        "summary": "Consultar una demolicion guardada por su UUID local",
        "operationId": "obtener_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demolicion confirmada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DemolicionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DatosInvalidos"
          },
          "404": {
            "description": "Registro local inexistente"
          }
        }
      }
    },
    "/api/comportamientos": {
      "get": {
        "tags": [
          "Comportamientos"
        ],
        "summary": "Obtener los comportamientos de un zombie y un creeper",
        "operationId": "obtenerComportamientos",
        "responses": {
          "200": {
            "description": "Comportamientos de las dos entidades de ejemplo",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComportamientosResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Inicio"
        ],
        "summary": "Consultar la presentacion de la API",
        "operationId": "inicio",
        "responses": {
          "200": {
            "description": "Mensaje de bienvenida",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "API REST - Sofia Torres - Minecraft"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Descripcion del error"
          }
        },
        "required": [
          "error"
        ]
      },
      "Atributos": {
        "type": "object",
        "description": "ZOMBIE: velocidad; CREEPER: fuseTime; ESQUELETO: tieneArco; ENDERMAN: puedeTomarBloques; CERDO: montable y edad; ALDEANO: profesion y nivelComercio; JUGADOR: capacidadInventario y modoCreativo. OTRO no admite atributos especificos. La capacidad de un inventario existente no puede cambiar.",
        "properties": {
          "velocidad": {
            "type": "number",
            "format": "double"
          },
          "fuseTime": {
            "type": "integer",
            "format": "int32"
          },
          "tieneArco": {
            "type": "boolean"
          },
          "puedeTomarBloques": {
            "type": "boolean"
          },
          "montable": {
            "type": "boolean"
          },
          "edad": {
            "type": "integer",
            "format": "int32"
          },
          "profesion": {
            "type": "string"
          },
          "nivelComercio": {
            "type": "integer",
            "format": "int32"
          },
          "capacidadInventario": {
            "type": "integer",
            "format": "int32"
          },
          "modoCreativo": {
            "type": "boolean"
          }
        }
      },
      "EntidadRequest": {
        "type": "object",
        "description": "Datos para crear o actualizar una entidad. Los atributos permitidos dependen del tipo.",
        "example": {
          "nombre": "Zombie1",
          "tipo": "ZOMBIE",
          "salud": 20,
          "ubicacion": {
            "x": 0,
            "y": 64,
            "z": 0
          },
          "atributos": {
            "velocidad": 1.5
          }
        },
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre no vacio; se recortan los espacios de los extremos",
            "maxLength": 100
          },
          "tipo": {
            "type": "string",
            "enum": [
              "JUGADOR",
              "ZOMBIE",
              "ESQUELETO",
              "CREEPER",
              "ENDERMAN",
              "CERDO",
              "ALDEANO",
              "OTRO"
            ]
          },
          "salud": {
            "type": "number",
            "format": "double",
            "description": "Salud finita y no negativa",
            "minimum": 0
          },
          "ubicacion": {
            "$ref": "#/components/schemas/Ubicacion"
          },
          "atributos": {
            "$ref": "#/components/schemas/Atributos",
            "description": "Opcionales. Al actualizar, se conservan los atributos que no se informan."
          }
        },
        "required": [
          "nombre",
          "salud",
          "tipo",
          "ubicacion"
        ]
      },
